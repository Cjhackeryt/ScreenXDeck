<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ScreenXDeckPlugin</AssemblyName>
    <RootNamespace>ScreenControl</RootNamespace>
    <Version>0.1.0</Version>
    <UseAppHost>false</UseAppHost>
    <UseWindowsForms>true</UseWindowsForms>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="MacroDeck.Plugin.Hosting" Version="3.0.0-beta.12" />
    <PackageReference Include="MacroDeck.Localization" Version="3.0.0-beta.12" />
    <PackageReference Include="MacroDeck.Sdk" Version="3.0.0-beta.12" />
    <PackageReference Include="MacroDeck.Ui" Version="3.0.0-beta.12" />
    <PackageReference Include="MacroDeck.Plugin.Serilog" Version="3.0.0-beta.12" />
    <PackageReference Include="MacroDeck.Plugin.Analyzers" Version="3.0.0-beta.12" PrivateAssets="all" />
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ScreenXDeck.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\icon.svg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
