{
  "version": 1,
  "targets": {
    "win-x64": {
      "executable": "dotnet",
      "arguments": [
        "publish",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "false",
        "-p:UseAppHost=false",
        "-p:EnableWindowsTargeting=true",
        "-o",
        "runtimes/win-x64"
      ],
      "output": "runtimes/win-x64"
    }
  }
}
